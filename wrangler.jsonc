// Local development config, used by `next dev` and `npm run preview`.
// Client deployments live in deployments/<slug>.jsonc (see docs/setup.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barber-sys-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "barber-sys-dev"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barber-sys-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "barber-sys-dev-media"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // The design (theme and colors) is not a var: owners pick it in the dashboard (Page & links → Design).
  "vars": {
    "DEFAULT_LOCALE": "ar",
    "TIMEZONE": "Asia/Jerusalem",
    "TURNSTILE_SITE_KEY": ""
  }
}
